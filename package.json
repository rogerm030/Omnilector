{
  "name": "omnilector",
  "version": "1.0.0",
  "description": "Omnilector — Lector unificado de libros EPUB y cómics (CBZ, CBR, CBT) con categorías y diseño Material Design 3 para Android, iOS y Web (PWA).",
  "private": true,
  "scripts": {
    "start": "npx serve www -l 3000",
    "cap:init": "npx cap init Omnilector com.omnilector.app --web-dir www",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:sync": "npx cap sync",
    "android": "npx cap open android",
    "ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}

